{
  "definition": {
    "kind": "hosted",
    "container_configuration": {
      "image": ""
    },
    "cpu": "0.5",
    "memory": "1Gi",
    "protocol_versions": [
      { "protocol": "responses", "version": "2.0.0" }
    ],
    "environment_variables": {
      "OTEL_EXPORTER_OTLP_ENDPOINT": "${{connections.otlp.target}}",
      "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
      "OTEL_EXPORTER_OTLP_HEADERS": "${{connections.otlp.credentials.headers}}"
    }
  }
}
